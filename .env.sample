# ==========================================
# НАЛАШТУВАННЯ ПАРСЕРУ (Scraping Settings)
# ==========================================
# Затримка між запитами в секундах (щоб донор не забанив IP)
REQUEST_DELAY=2

# Кількість спроб завантажити сторінку, якщо сайт-донор "лежить"
MAX_RETRIES=3

# Юзер-агент, чтобы донор думал, что мы обычный браузер
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/119.0.0.0 Safari/537.36

# ==========================================
# ШЛЯХИ ДО ФАЙЛІВ (File Paths для Docker)
# ==========================================
# Де скрипт шукатиме XLS-прайси
INPUT_DIR=./data/input

# Куди скрипт зберігатиме готовий YML для Прома
OUTPUT_DIR=./data/output

# ==========================================
# НАЛАШТУВАННЯ YML/XML (Prom.ua settings)
# ==========================================
# Назва компанії замовника (потрібна у шапці YML)
COMPANY_NAME=COMPANY_NAME

# Посилання на сайт замовника (потрібне у шапці YML)
SHOP_URL=SHOP_URL